# Copy to `.env.local` for local development — never commit real secrets.

# Required for `/api/youtube/playlist`.
YOUTUBE_API_KEY=

# Optional: experimental Spotify import path (`/api/spotify/playlist`).
# Create credentials at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional YouTube OAuth export. Redirect URI must exactly match the deployed origin,
# e.g. http://localhost:3000/api/youtube/oauth/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Optional Apple Music library import/export. Keep the private key server-side.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Optional anonymous transition feedback collection.
FEEDBACK_SUPABASE_URL=
FEEDBACK_SUPABASE_SERVICE_ROLE_KEY=
